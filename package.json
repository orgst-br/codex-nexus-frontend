{
  "name": "codex-orgst",
  "version": "1.0.0",
  "private": true,
  "description": "Orgst Community Platform - Frontend",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "cross-env jest --passWithNoTests --maxWorkers=50%",
    "test:watch": "cross-env jest --watch --maxWorkers=50%",
    "test:coverage": "cross-env jest --coverage --maxWorkers=50%",
    "test:ci": "cross-env jest --coverage --watchAll=false --maxWorkers=50%",
    "generate-types": "bash scripts/generate-api-types.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "@tanstack/react-query": "^5.75.5",
    "@tanstack/react-query-devtools": "^5.75.5",
    "i18next": "^25.4.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "next": "^14.2.0",
    "openapi-fetch": "^0.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.49.2",
    "react-i18next": "^15.7.0",
    "styled-components": "^6.1.8",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@happy-dom/jest-environment": "^20.5.0",
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "prettier": "^3.6.2",
    "typescript": "^5.3.3"
  }
}
