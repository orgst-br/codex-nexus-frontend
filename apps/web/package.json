{
  "name": "@orgst/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "check-format": "prettier --check . --ignore-path ../../.prettierignore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "cross-env jest --passWithNoTests --maxWorkers=50%",
    "test:watch": "cross-env jest --watch --maxWorkers=50%",
    "test:coverage": "cross-env jest --coverage --maxWorkers=50%",
    "test:ci": "cross-env jest --coverage --watchAll=false --maxWorkers=50%"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "@tanstack/react-query": "^5.75.5",
    "@tanstack/react-query-devtools": "^5.75.5",
    "i18next": "^25.4.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "next": "^14.2.0",
    "openapi-fetch": "^0.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.49.2",
    "react-i18next": "^15.7.0",
    "styled-components": "^6.1.8",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@orgst/config": "workspace:*",
    "@orgst/eslint-config": "workspace:*",
    "@happy-dom/jest-environment": "^20.5.0",
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "cross-env": "^7.0.3",
    "eslint": "^9.34.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "prettier": "^3.6.2",
    "typescript": "^5.3.3"
  }
}
